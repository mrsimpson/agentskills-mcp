{
  "name": "@codemcp/skills-core",
  "version": "2.3.6",
  "description": "Core functionality for Agent Skills parsing, validation, and discovery",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./install": {
      "import": "./dist/install.js",
      "types": "./dist/install.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean:build": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "gray-matter": "4.0.3",
    "js-yaml": "^4.1.0",
    "pacote": "21.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.11",
    "@types/pacote": "11.1.8",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.21.0",
    "vitest": "^3.0.3"
  },
  "keywords": [
    "agentskills",
    "skills",
    "parser",
    "validator"
  ],
  "author": "Oliver Jägle <github@beimir.net>",
  "license": "MIT",
  "private": true
}
